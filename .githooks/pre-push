#!/bin/sh
# Refuse to push unless the remote is a verified PRIVATE GitHub repository and
# no private-looking data is tracked. Enable with: git config core.hooksPath .githooks
remote="$1"
uv run studyctl check-remote --remote "$remote" || {
  echo "pre-push: remote '$remote' is not verified PRIVATE. Push blocked." >&2
  exit 1
}
uv run python scripts/check_tracked_files.py || exit 1
