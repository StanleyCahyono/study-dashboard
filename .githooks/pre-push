#!/bin/sh
# Block pushes that would publish personal data. The repository is PUBLIC
# (owner decision 2026-11-10), so this scan is the main safeguard.
# Enable with: git config core.hooksPath .githooks
if command -v uv >/dev/null 2>&1; then
  uv run python scripts/check_tracked_files.py || exit 1
else
  python3 scripts/check_tracked_files.py || python scripts/check_tracked_files.py || exit 1
fi
